<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://clientesapi.example.com/"
        xmlns:tns="http://clientesapi.example.com/"
        elementFormDefault="qualified">

    <xs:complexType name="Cliente">
        <xs:sequence>
            <xs:element name="id"
                        type="xs:long"
                        minOccurs="0"/>

            <xs:element name="rzoSocial"
                        type="xs:string"
                        minOccurs="0"/>

            <xs:element name="ruc"
                        type="xs:string"
                        minOccurs="0"/>

            <xs:element name="tipoCliente"
                        type="xs:string"
                        minOccurs="0"/>

            <xs:element name="email"
                        type="xs:string"
                        minOccurs="0"/>

            <xs:element name="telefono"
                        type="xs:string"
                        minOccurs="0"/>

            <xs:element name="estado"
                        type="xs:boolean"
                        minOccurs="0"
                        nillable="true"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="cliente" type="tns:Cliente"/>

</xs:schema>